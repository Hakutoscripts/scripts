-- --- СТРАНИЦЫ ---
local Pages = {}
local function createPage(name)
    local frame = Instance.new("ScrollingFrame", MainFrame)
    frame.Size = UDim2.new(1, -20, 1, -100)
    frame.Position = UDim2.new(0, 10, 0, 90)
    frame.BackgroundTransparency = 1
    frame.ScrollBarThickness = 0
    frame.Visible = (name == "Home")
    Instance.new("UIListLayout", frame).Padding = UDim.new(0, 10)
    Pages[name] = frame
    return frame
end
 
local Home = createPage("Home")
local Event = createPage("Event")
local Misc = createPage("Misc")
 
for _, name in pairs({"Home", "Event", "Misc"}) do
    local btn = Instance.new("TextButton", TabContainer)
    btn.Size = UDim2.new(0.31, 0, 1, 0)
    btn.Text = name
    btn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    btn.TextColor3 = Color3.new(1,1,1)
    Instance.new("UICorner", btn)
    btn.MouseButton1Click:Connect(function()
        for _, p in pairs(Pages) do p.Visible = false end
        Pages[name].Visible = true
    end)
end
 
-- --- ЛОГИКА ФУНКЦИЙ ---
local function addButton(parent, text, callback)
    local btn = Instance.new("TextButton", parent)
    btn.Size = UDim2.new(1, 0, 0, 40)
    btn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    btn.Text = text
    btn.TextColor3 = Color3.new(1, 1, 1)
    Instance.new("UICorner", btn)
    btn.MouseButton1Click:Connect(function() callback(btn) end)
    return btn
end
 
-- WalkSpeed
local lbl = Instance.new("TextLabel", Home)
lbl.Size = UDim2.new(1, 0, 0, 20)
lbl.Text = "Walk Speed"
lbl.TextColor3 = Color3.new(1, 1, 1)
