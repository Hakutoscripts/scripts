RunService.Stepped:Connect(function()
    if _G.Noclip and player.Character then
        for _, v in pairs(player.Character:GetDescendants()) do 
            if v:IsA("BasePart") then v.CanCollide = false end 
        end
    end
end)
 
addButton(Event, "Auto Farm: OFF", function(btn)
    _G.Farm = not _G.Farm
    btn.Text = _G.Farm and "Auto Farm: ON" or "Auto Farm: OFF"
    task.spawn(function()
        while _G.Farm do
            local char = player.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                local folder = workspace:FindFirstChild("Smmer")
                if folder then
                    for _, ball in pairs(folder:GetChildren()) do
                        if _G.Farm and ball.Name == "SummerBall" then
                            char.HumanoidRootPart.CFrame = ball.CFrame
                            firetouchinterest(char.HumanoidRootPart, ball, 0)
                            firetouchinterest(char.HumanoidRootPart, ball, 1)
                        end
                    end
                end
            end
            task.wait(0.2)
        end
    end)
end)
 
addButton(Misc, "Rainbow UI: OFF", function(btn)
    _G.Rainbow = not _G.Rainbow
    btn.Text = _G.Rainbow and "Rainbow UI: ON" or "Rainbow UI: OFF"
    task.spawn(function()
        while _G.Rainbow do
            for i = 0, 1, 0.05 do
                if not _G.Rainbow then break end
                MainFrame.BackgroundColor3 = Color3.fromHSV(i, 0.5, 0.5)
                task.wait(0.1)
            end
        end
        MainFrame.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
    end)
end)
 
-- Звезды
local StarHolder = Instance.new("Frame", MainFrame)
StarHolder.Size = UDim2.new(1, 0, 1, 0)
StarHolder.BackgroundTransparency = 1
StarHolder.ZIndex = 0
 
task.spawn(function()
    while MainFrame.Parent do
        local star = Instance.new("Frame", StarHolder)
        star.Size = UDim2.new(0, 3, 0, 3)
        star.Position = UDim2.new(math.random(), 0, 1.1, 0)
        star.BackgroundColor3 = Color3.new(1, 1, 1)
        Instance.new("UICorner", star).CornerRadius = UDim.new(1, 0)
        
        TweenService:Create(star, TweenInfo.new(math.random(4, 8)), {Position = UDim2.new(star.Position.X.Scale, 0, -0.1, 0)}):Play()
        task.delay(5, function() star:Destroy() end)
        task.wait(0.4)
    end
end)
 
