StatusLabel.Position = UDim2.new(0, 0, 1, 0)
StatusLabel.BackgroundTransparency = 1
StatusLabel.Text = "DISABLED"
StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
StatusLabel.TextSize = 16
StatusLabel.Font = Enum.Font.GothamBold
StatusLabel.TextScaled = true
StatusLabel.Parent = MainFrame

-- ФУНКЦИЯ ОБНОВЛЕНИЯ КНОПКИ
local function UpdateUI()
    if Enabled then
        ToggleButton.BackgroundColor3 = Color3.fromRGB(50, 255, 50) -- Зеленый
        ButtonLabel.Text = "ON"
        StatusLabel.Text = "ENABLED"
        StatusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
    else
        ToggleButton.BackgroundColor3 = Color3.fromRGB(255, 50, 50) -- Красный
        ButtonLabel.Text = "OFF"
        StatusLabel.Text = "DISABLED"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
    end
end

-- ОБРАБОТЧИК НАЖАТИЯ НА КНОПКУ (для телефона и ПК)
ToggleButton.MouseButton1Click:Connect(function()
    Enabled = not Enabled
    UpdateUI()
    
    -- Вибрация на телефоне (если поддерживается)
    if UserInputService.TouchEnabled then
        task.wait(0.05)
        -- Небольшая анимация нажатия
        ToggleButton.Size = UDim2.new(0, 90, 0, 90)
        ToggleButton.Position = UDim2.new(0.5, -45, 0.5, -45)
        task.wait(0.1)
        ToggleButton.Size = UDim2.new(0, 100, 0, 100)
        ToggleButton.Position = UDim2.new(0.5, -50, 0.5, -50)
    end
end)

-- Также нажатие на весь фрейм (для удобства)
MainFrame.MouseButton1Click:Connect(function()
    Enabled = not Enabled
    UpdateUI()
end)

-- ФУНКЦИЯ ПАРИРОВАНИЯ
local function PressParry()
    if not Enabled then return end
    if not Character or not Character.Parent then return end
    if Humanoid.Health <= 0 then return end
    
    UserInputService:SetKeyDown(ParryKey)
    task.wait(0.05)
    UserInputService:SetKeyUp(ParryKey)
end

-- ПОИСК БЛИЖАЙШЕГО МЯЧА
local function GetNearestBall()
    local Ball = nil
    local ClosestDistance = ParryRange
    
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("BasePart") and (v.Name == "Ball" or v.Name == "Handle") then
            local owner = v:FindFirstAncestorOfClass("Model")
            if owner and owner:FindFirstChild("Humanoid") and owner ~= Character then
                local distance = (v.Position - Character.HumanoidRootPart.Position).Magnitude
                if distance < ClosestDistance then
                    ClosestDistance = distance
                    Ball = v
                end
            end
        end
    end
    return Ball, ClosestDistance
end

-- ОСНОВНОЙ ЦИКЛ
RunService.Heartbeat:Connect(function()
    if not Enabled then return end
    if not Character or not Character.Parent then return end
    if Humanoid.Health <= 0 then return end
    
    local Ball, Distance = GetNearestBall()
    
    if Ball then
        local Velocity = Ball.AssemblyLinearVelocity
        if Velocity.Magnitude > 10 then
            local DirectionToPlayer = (Character.HumanoidRootPart.Position - Ball.Position).Unit
            local DotProduct = Velocity.Unit:Dot(DirectionToPlayer)
            
            if DotProduct > 0.3 and Distance < ParryRange then
                PressParry()
            end
        end
    end
end)

-- ПЕРЕСОЗДАНИЕ UI ПРИ СМЕРТИ
LocalPlayer.CharacterAdded:Connect(function(newChar)
    Character = newChar
    Humanoid = Character:WaitForChild("Humanoid")
end)

-- НАЧАЛЬНОЕ СОСТОЯНИЕ
UpdateUI()

print("✅ Auto Parry с кнопкой загружен! Нажми на круглую кнопку на экране.")
