local pityLabel = Instance.new('TextLabel', mainFrame)
pityLabel.Size = UDim2.new(1, 0, 0, 35)
pityLabel.Position = UDim2.new(0, 0, 0.9, 0)
pityLabel.Text = 'LR Pity: ?/2000'
pityLabel.Font = Enum.Font.Cartoon
pityLabel.TextSize = 22
pityLabel.TextColor3 = Color3.fromRGB(255, 255, 100)
pityLabel.BackgroundTransparency = 1

spawn(function()
    local miscStats = player:FindFirstChild('MiscStats')
    local lrPity
    local t = 0
    while t < 5 and not lrPity do
        if miscStats then lrPity = miscStats:FindFirstChild('LRPity') end
        if not lrPity then waitT(0.1) t = t + 0.1 end
    end
    if lrPity then
        local function update()
            pityLabel.Text = 'LR Pity: ' .. tostring(lrPity.Value) .. '/2000'
        end
        update()
        lrPity:GetPropertyChangedSignal('Value'):Connect(update)
    else
        warn('[MENU] LRPity не найден в MiscStats')
    end
end)
