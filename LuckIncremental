-- ---------- Auto-Farm Controls ----------
local windows = {
    { name = 'Tokenize',      event = findEvent('tokenizeReq'),    color = Color3.fromRGB(255, 170, 0), args = nil },
    { name = 'Energize',      event = findEvent('energyRequest'),  color = Color3.fromRGB(0, 120, 255), args = { 'ReportClicks', 50 } },
    { name = 'Marketize',     event = findEvent('marketReq'),      color = Color3.fromRGB(140, 255, 140), args = nil },
    { name = 'Temperaturize', event = findEvent('temperatureReq'), color = Color3.fromRGB(255, 100, 100), args = nil, isTemperaturize = true },
}

local yPos = 0.15
local runningStates = {}

for i, win in ipairs(windows) do
    local label = Instance.new('TextLabel', mainFrame)
    label.Size = UDim2.new(0, 100, 0, 30)
    label.Position = UDim2.new(0.05, 0, yPos, 0)
    label.Text = win.name
    label.Font = Enum.Font.Cartoon
    label.TextSize = 20
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.BackgroundTransparency = 1
    label.TextXAlignment = Enum.TextXAlignment.Left

    local status = Instance.new('TextLabel', mainFrame)
    status.Size = UDim2.new(0, 80, 0, 30)
    status.Position = UDim2.new(0.35, 0, yPos, 0)
    status.Text = 'Stopped'
    status.Font = Enum.Font.Cartoon
    status.TextSize = 18
    status.TextColor3 = Color3.fromRGB(255, 100, 100)
    status.BackgroundTransparency = 1

    local startBtn = makeButton(mainFrame, 'Start',
        UDim2.new(0.58, 0, yPos, 0), Color3.fromRGB(0, 150, 0),
        Color3.fromRGB(255, 255, 255), 60, 30, 18)

    local stopBtn = makeButton(mainFrame, 'Stop',
        UDim2.new(0.79, 0, yPos, 0), Color3.fromRGB(180, 0, 0),
        Color3.fromRGB(255, 255, 255), 60, 30, 18)

    runningStates[i] = false

    local function loop()
        if win.isTemperaturize then
            -- Специальный цикл для Temperaturize (без continue — для старых экзекуторов)
            while runningStates[i] do
                local character = player.Character
                if not character or not character:FindFirstChild('HumanoidRootPart') then
                    waitT(1)
                else
                    local stats = player:FindFirstChild('Stats')
                    local resources = {
                        { name = 'Ash',     part = workspace:FindFirstChild('Ash'),     stat = stats and stats:FindFirstChild('Ash') },
                        { name = 'Igneous', part = workspace:FindFirstChild('Igneous'), stat = stats and stats:FindFirstChild('Igneous') },
                        { name = 'Lava',    part = workspace:FindFirstChild('Lava'),    stat = stats and stats:FindFirstChild('Lava') },
                        { name = 'Magma',   part = workspace:FindFirstChild('Magma'),   stat = stats and stats:FindFirstChild('Magma') },
                    }

                    local success = true
                    for _, resource in ipairs(resources) do
                        if not runningStates[i] then break end

                        local failReason = nil
                        if not resource.part then
                            failReason = 'нет части ' .. resource.name .. ' в workspace'
                        elseif not resource.part:FindFirstChild('Touch') then
                            failReason = 'нет Touch у ' .. resource.name
                        elseif not resource.stat then
                            failReason = 'нет стата ' .. resource.name
                        end

                        if failReason then
                            print('[Temperaturize] ERROR: ' .. failReason)
                            local tel = EventsFolder and EventsFolder:FindFirstChild('teleportEvent')
                            if tel then pcall(function() tel:FireServer('World7Arrival') end) end
                            runningStates[i] = false
                            status.Text = 'Stopped'
                            status.TextColor3 = Color3.fromRGB(255, 100, 100)
                            success = false
                            break
                        end

                        local initialValue = resource.stat.Value
                        character.HumanoidRootPart.CFrame = resource.part.Touch.CFrame

                        local collected = false
                        local waited = 0
                        while waited < 2 and not collected do
                            waitT(0.1)
                            waited = waited + 0.1
                            if resource.stat.Value > initialValue then
                                collected = true
                            end
                        end

                        if not collected then
                            -- Повторная попытка
                            initialValue = resource.stat.Value
                            character.HumanoidRootPart.CFrame = resource.part.Touch.CFrame
                            waited = 0
                            while waited < 2 and not collected do
                                waitT(0.1)
                                waited = waited + 0.1
                                if resource.stat.Value > initialValue then
                                    collected = true
                                end
                            end

                            if not collected then
                                print('[Temperaturize] ERROR: не удалось собрать ' .. resource.name .. ' - телепорт в World 7')
                                local tel = EventsFolder and EventsFolder:FindFirstChild('teleportEvent')
                                if tel then pcall(function() tel:FireServer('World7Arrival') end) end
                                runningStates[i] = false
                                status.Text = 'Stopped'
                                status.TextColor3 = Color3.fromRGB(255, 100, 100)
                                success = false
                                break
                            end
                        end
                    end

                    if success and runningStates[i] and win.event then
                        pcall(function() win.event:FireServer() end)
                        waitT(0.5)
                    end
                end
            end
        else
            -- Обычный цикл
            while runningStates[i] and win.event do
                pcall(function()
                    if win.args then
                        win.event:FireServer(unpack(win.args))
                    else
                        win.event:FireServer()
                    end
                end)
                waitT(0.1)
            end
        end
    end

    startBtn.MouseButton1Click:Connect(function()
        if not runningStates[i] then
            if not win.event then
                warn('[MENU] Нечего запускать: событие ' .. win.name .. ' не найдено')
                return
            end
            runningStates[i] = true
            status.Text = 'Running'
            status.TextColor3 = Color3.fromRGB(100, 255, 100)
            spawn(loop)
        end
    end)

    stopBtn.MouseButton1Click:Connect(function()
        runningStates[i] = false
        status.Text = 'Stopped'
        status.TextColor3 = Color3.fromRGB(255, 100, 100)
    end)

    yPos = yPos + 0.22
end

