-- ===== ПОИСК РАКЕТЫ =====
local function getRocketInHand()
    if not character then return nil end
    
    -- Проверяем инструменты в руках
    local tool = character:FindFirstChildOfClass("Tool")
    if tool then
        if tool.Name:lower():find("rocket") then
            return tool
        end
        -- Проверяем Handle
        local handle = tool:FindFirstChild("Handle")
        if handle and handle.Name:lower():find("rocket") then
            return tool
        end
    end
    
    -- Проверяем, может ракета уже запущена
    for _, child in pairs(workspace:GetChildren()) do
        if child.Name:lower():find("rocket") and child:IsA("Part") then
            return child
        end
    end
    
    return nil
end

-- ===== СОЗДАНИЕ ОГНЕННОГО СЛЕДА =====
local function createTrail(part)
    if not CONFIG.TrailEnabled then return end
    
    local trail = Instance.new("Trail")
    trail.Parent = part
    trail.Lifetime = 1.0
    trail.MinLength = 1
    trail.MaxLength = 20
    trail.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.1),
        NumberSequenceKeypoint.new(0.3, 0.4),
        NumberSequenceKeypoint.new(0.7, 0.7),
        NumberSequenceKeypoint.new(1, 1)
    })
    trail.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.new(1, 0.9, 0.4)),
        ColorSequenceKeypoint.new(0.4, Color3.new(1, 0.6, 0.1)),
        ColorSequenceKeypoint.new(0.8, Color3.new(0.8, 0.2, 0)),
        ColorSequenceKeypoint.new(1, Color3.new(0.4, 0, 0))
    })
    
    -- Световой эффект
    local light = Instance.new("PointLight")
    light.Parent = part
    light.Range = 25
    light.Brightness = 4
    light.Color = Color3.new(1, 0.6, 0.1)
end

-- ===== ВЗРЫВ =====
local function createExplosion(position, radius, damage)
    -- Основной взрыв
    local explosion = Instance.new("Explosion")
    explosion.Position = position
    explosion.Radius = radius
    explosion.BlastPressure = 800000
    explosion.BlastImpulse = 200
    explosion.DestroyJointRadiusPercent = 0.9
    explosion.Parent = workspace
    
    -- Урон игрокам
    if damage and damage > 0 then
        local parts = workspace:GetPartsInPart(explosion, 1)
        for _, part in pairs(parts) do
            local hitChar = part:FindFirstAncestorOfClass("Model")
            if hitChar and hitChar:FindFirstChild("Humanoid") then
                local hum = hitChar:FindFirstChild("Humanoid")
                if hum and hum ~= humanoid then
                    hum:TakeDamage(damage)
                end
            end
        end
    end
    
    Debris:AddItem(explosion, 0.3)
    
    -- Огненная сфера
    local fire = Instance.new("Part")
    fire.Shape = Enum.PartType.Ball
    fire.Size = Vector3.new(radius * 0.5, radius * 0.5, radius * 0.5)
    fire.Material = Enum.Material.Neon
    fire.Color = Color3.new(1, 0.6, 0.1)
    fire.Transparency = 0.2
    fire.Anchored = true
    fire.CanCollide = false
    fire.Position = position
    fire.Parent = workspace
    
    -- Анимация расширения сферы
    local startSize = fire.Size
    local goalSize = startSize * 3
    local startTime = tick()
    local duration = 0.8
    
    RunService.Heartbeat:Connect(function()
        local elapsed = (tick() - startTime) / duration
        if elapsed >= 1 then
            fire:Destroy()
            return
        end
        local size = startSize:Lerp(goalSize, elapsed)
        fire.Size = size
        fire.Transparency = 0.2 + (elapsed * 0.8)
    end)
    
    -- Землетрясение (вибрация камеры)
    local camera = workspace.CurrentCamera
    if camera then
        local originalPos = camera.CFrame.Position
        for i = 1, 10 do
            local offset = Vector3.new(
                math.random(-3, 3),
                math.random(-2, 2),
                math.random(-3, 3)
            )
            camera.CFrame = CFrame.new(originalPos + offset)
            task.wait(0.03)
        end
        camera.CFrame = CFrame.new(originalPos)
    end
end

-- ===== ЗАПУСК МБР =====
local function launchICBM(rocket)
    local handle
    
    -- Определяем, что является ракетой
    if rocket:IsA("Tool") then
        handle = rocket:FindFirstChild("Handle")
        if not handle then
            statusText.Text = "❌ Ошибка: нет Handle!"
            return
        end
    else
        handle = rocket
    end
    
    statusText.Text = "🔥 ЗАПУСК!"
    statusText.TextColor3 = Color3.fromRGB(255, 100, 50)
    
    -- Отключаем физику
    handle.Anchored = true
    handle.CanCollide = false
    
    -- Направление полета
    local direction = handle.CFrame.LookVector
    if direction.Magnitude < 0.1 then
        direction = Vector3.new(0, 0, -1)
    end
    
    -- След
    createTrail(handle)
    
    -- Звуковой эффект (если есть звук)
    local sound = Instance.new("Sound")
    sound.SoundId = "rbxassetid://183948274" -- Звук ракеты
    sound.Volume = 0.8
    sound.Parent = handle
    sound:Play()
    Debris:AddItem(sound, 5)
    
    -- Частицы двигателя
    local function createParticles()
        for i = 1, 3 do
            local particle = Instance.new("Part")
            particle.Shape = Enum.PartType.Ball
            particle.Size = Vector3.new(0.3 + math.random(), 0.3 + math.random(), 0.3 + math.random())
            particle.Material = Enum.Material.Neon
            particle.Color = Color3.new(1, 0.8, 0.2)
            particle.Transparency = 0.3
            particle.Anchored = true
            particle.CanCollide = false
            particle.Position = handle.Position - direction * 3 + Vector3.new(
                math.random(-1, 1),
                math.random(-1, 1),
                math.random(-1, 1)
            )
            particle.Parent = workspace
            Debris:AddItem(particle, 0.8)
        end
    end
    
    -- Основной полет
    local startTime = tick()
    local connection
    local particleTimer = 0
    
    connection = RunService.Heartbeat:Connect(function(deltaTime)
        local elapsed = tick() - startTime
        
        if elapsed > CONFIG.FlightDuration or not handle.Parent then
            if connection then connection:Disconnect() end
            return
        end
        
        -- Движение
        local velocity = direction * CONFIG.FlightSpeed * deltaTime
        handle.Position = handle.Position + velocity
        
        -- Поворот
        if velocity.Magnitude > 0.5 then
            handle.CFrame = CFrame.lookAt(handle.Position, handle.Position + velocity)
        end
        
        -- Частицы
        particleTimer = particleTimer + deltaTime
        if particleTimer > 0.04 then
            particleTimer = 0
            createParticles()
        end
        
        -- Обновляем статус
        local distance = (handle.Position - character.HumanoidRootPart.Position).Magnitude
        if distance > 50 then
            statusText.Text = "🚀 Полет... " .. math.floor(distance) .. "м"
        end
    end)
    
    -- Таймер автовзрыва
    task.wait(CONFIG.FlightDuration)
    if handle and handle.Parent then
        if connection then connection:Disconnect() end
        createExplosion(handle.Position, CONFIG.ExplosionRadius, CONFIG.ExplosionDamage)
        handle:Destroy()
        statusText.Text = "💥 ВЗРЫВ!"
        statusText.TextColor3 = Color3.fromRGB(255, 50, 50)
        task.wait(2)
        statusText.Text = "📡 Готов к запуску"
        statusText.TextColor3 = Color3.fromRGB(200, 200, 200)
    end
end

-- ===== ОБНАРУЖЕНИЕ СТОЛКНОВЕНИЙ =====
local function setupCollisionDetection(rocket)
    if not rocket then return end
    
    local handle = rocket:IsA("Tool") and rocket:FindFirstChild("Handle") or rocket
    if not handle then return end
    
    handle.Touched:Connect(function(hit)
        if not handle.Parent then return end
        local hitParent = hit.Parent
        if hitParent == character or hitParent == player then return end
        
        -- Взрыв при столкновении
        if handle.Anchored == false then return end
        
        createExplosion(handle.Position, CONFIG.ExplosionRadius, CONFIG.ExplosionDamage)
        handle:Destroy()
        statusText.Text = "💥 СТОЛКНОВЕНИЕ!"
        statusText.TextColor3 = Color3.fromRGB(255, 50, 50)
        task.wait(2)
        statusText.Text = "📡 Готов к запуску"
        statusText.TextColor3 = Color3.fromRGB(200, 200, 200)
    end)
end

-- ===== АВТОЗАПУСК =====
local function checkForRocket()
    if CONFIG.AutoLaunch then
        local rocket = getRocketInHand()
        if rocket then
            local handle = rocket:IsA("Tool") and rocket:FindFirstChild("Handle") or rocket
            if handle and handle.Anchored == false then
                statusText.Text = "🚀 Автозапуск!"
                statusText.TextColor3 = Color3.fromRGB(50, 255, 50)
                task.wait(0.5)
                launchICBM(rocket)
            end
        end
    end
end

